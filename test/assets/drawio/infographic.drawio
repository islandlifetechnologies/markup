                <mxCell id="InMluSGs0avUXqITv8cf-10" value="&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#ffffff&quot;&gt;&lt;b&gt;Delight our customers&lt;/b&gt;&lt;/font&gt;&lt;font size=&quot;1&quot;&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;Agile processes have built-in fast feedback cycles so we can find out and deliver what our customers need and want.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;strokeColor=none;fillColor=none;align=left;arcSize=0;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;spacing=10;shadow=0;fontColor=#C87104;spacingLeft=70;" vertex="1" parent="1">
